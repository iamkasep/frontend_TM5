# Fallback SPA untuk hosting Apache/cPanel: semua URL non-file diarahkan ke index.html
# agar refresh di rute seperti /admin/shipments/SHP-001 tidak menghasilkan 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
