# Kosongkan untuk memakai mock data (mode simulasi di localStorage).
# Isi dengan base URL backend setelah API dari tim Laravel tersedia.
# - Contoh produksi : https://api.tms.wmshil.com/api
# - Contoh dev lokal: /api  (dengan VITE_DEV_PROXY_TARGET di bawah agar bebas CORS)
VITE_API_BASE_URL=

# Konvensi nama field JSON dari/ke backend Laravel:
# - camel (default): backend mengirim & menerima camelCase (customerId, weightKg).
# - snake          : backend mengirim & menerima snake_case bawaan Laravel (customer_id, weight_kg).
#                    Interceptor di src/services/api.js otomatis mengonversi request/response & error 422.
VITE_API_CASE=camel

# Opsional (hanya dev): alamat server Laravel lokal untuk proxy Vite bila VITE_API_BASE_URL=/api.
# Awalan /api pada URL browser akan diteruskan ke target, mis. jika target http://127.0.0.1:8000/api
# maka request /api/shipments diteruskan ke http://127.0.0.1:8000/api/shipments.
VITE_DEV_PROXY_TARGET=

# Opsional: gaya peta OpenFreeMap (tanpa API key).
# Pilihan: liberty (default, paling detail), bright, positron, dark, fiord
VITE_MAP_STYLE=liberty

# Opsional: nomor SMS gateway/admin penerima laporan posisi saat driver tidak punya internet.
# Format internasional, mis. +628123456789. Kosongkan agar driver memilih penerima sendiri di aplikasi SMS.
VITE_SMS_GATEWAY_NUMBER=
